<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DarmixNight" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dn_bg</item>
        <item name="android:colorAccent">@color/dn_ember</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DarmixNight.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dn_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dn_splash_moon</item>
        <item name="postSplashScreenTheme">@style/Theme.DarmixNight</item>
    </style>

</resources>
