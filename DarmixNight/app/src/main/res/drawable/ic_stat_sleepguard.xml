    android:viewportHeight="108">

    <!-- Arco guardián -->
    <path
        android:pathData="M70,26.3 A32,32 0 0 0 38,81.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Luna creciente limpia (una sola figura cerrada) -->
