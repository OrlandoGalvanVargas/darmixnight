        android:pathData="M67,41 l1.9,4.6 l4.6,1.9 l-4.6,1.9 l-1.9,4.6 l-1.9,-4.6 l-4.6,-1.9 l4.6,-1.9 z" />

    <!-- Estrella pequeña abajo a la derecha -->
