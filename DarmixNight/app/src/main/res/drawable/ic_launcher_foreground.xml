<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arco guardián: semicírculo centrado en (54,54), el centro exacto
         del lienzo — mismo centro que la luna. -->
    <path
        android:pathData="M70,26.3 A32,32 0 0 0 38,81.7"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38" android:startY="26"
                android:endX="70" android:endY="82">
                <item android:offset="0" android:color="#FFB9A8FF" />
                <item android:offset="1" android:color="#FF6C58D8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Luna creciente: UNA sola figura cerrada, no dos círculos con
         evenOdd. Se calculan los dos puntos donde el círculo exterior
         (centro 54,54 r21) y el círculo recortador (centro 63,46 r18)
         se cruzan, y se traza: arco largo por el borde exterior lejano
         + arco corto por el borde interior cóncavo. Así es imposible que
         aparezca una segunda figura suelta, sin importar cuánto se salga
         el círculo recortador del principal. -->
    <path
        android:pathData="M50.2,33.35
                          A21,21 0 1,0 74.07,60.19
                          A18,18 0 0,1 50.2,33.35
                          Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="33"
                android:endX="70" android:endY="75">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FFEDE7FF" />
                <item android:offset="1" android:color="#FFC3B4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Estrella principal, anidada justo en el hueco cóncavo de la luna
         (donde antes aparecía la "segunda luna" fantasma) — el clásico
         gesto de estrella-dentro-de-la-luna. -->
    <path android:fillColor="#FFE9E2FF"
        android:pathData="M67,41 l1.9,4.6 l4.6,1.9 l-4.6,1.9 l-1.9,4.6 l-1.9,-4.6 l-4.6,-1.9 l4.6,-1.9 z" />
    <!-- Estrella pequeña de acento, fuera de la luna, abajo a la derecha. -->
    <path android:fillColor="#FFBCA9FF"
        android:pathData="M66,73 l1.2,2.9 l2.9,1.2 l-2.9,1.2 l-1.2,2.9 l-1.2,-2.9 l-2.9,-1.2 l2.9,-1.2 z" />
</vector>